{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Dino Runner",
      "type": "shell",
      "command": "${workspaceFolder}\\compile.bat",
      "options": { "shell": { "executable": "cmd.exe", "args": ["/c"] } },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Dino Runner",
      "type": "shell",
      "command": "${workspaceFolder}\\run.bat",
      "options": { "shell": { "executable": "cmd.exe", "args": ["/c"] } },
      "problemMatcher": []
    }
  ]
}
